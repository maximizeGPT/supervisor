# Swift / SPM
.build/
.swiftpm/
Package.resolved
*.xcodeproj/
*.xcworkspace/
DerivedData/

# Build output (.app bundles produced by Scripts/build-app.sh)
build/

# Intermediate iconset directory generated by Scripts/make-icns.sh. Only
# the final branding/AppIcon.icns is committed (it's small and lets
# downstream consumers build without re-running sips/iconutil).
branding/AppIcon.iconset/

# Compiled spike binaries (rebuilt from source as needed)
spikes/kqueue_spike
spikes/notify_spike
spikes/NotifySpike.app/
spikes/*.log
spikes/*.err
spikes/entitlements.plist

# macOS
.DS_Store
*.swp

# Secrets
*.env
.env
.env.*
ANTHROPIC_API_KEY
secrets/

# Local test artifacts
test-output/
coverage/
*.xcresult

# Generated at runtime by the dispatch loop hook
OWNER-BRIEF.md
