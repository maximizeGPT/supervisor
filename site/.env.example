# LaunchList waitlist (getlaunchlist.com, free tier). Copy this to .env.local and
# set your project's FORM KEY (the "Public key" on the LaunchList Integration page).
# The embed widget reads it via data-key-id.
#
# The key is public by design (LaunchList embeds it in its own client-side widget),
# so NEXT_PUBLIC_ is correct and there is no server secret. Without it the widget
# renders empty.
#
#   cp .env.example .env.local
#   NEXT_PUBLIC_LAUNCHLIST_KEY=your-form-key
#
NEXT_PUBLIC_LAUNCHLIST_KEY=
