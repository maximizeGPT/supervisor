# Waitlist form endpoint. Copy this file to .env.local and set your real value.
# Any endpoint that accepts a POST works (Formspree, Buttondown, your own URL, etc.).
# Until this is set, the form validates the email and shows the success state
# locally without sending anything anywhere.
#
#   cp .env.example .env.local
#   NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/your-id
#
NEXT_PUBLIC_WAITLIST_ENDPOINT=
