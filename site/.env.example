# LaunchList waitlist (getlaunchlist.com). Copy this file to .env.local and set
# your project's FORM KEY. Create a free project at getlaunchlist.com, then find
# the key on the project's Integration page.
#
# The form key is public by design (LaunchList embeds it in its own client-side
# widgets), so NEXT_PUBLIC_ is correct and there is no server secret here.
# Until it is set, the waitlist runs in demo mode: it validates the email and
# shows the full post-signup flow (referral link, queue position, share) locally,
# without sending anything anywhere.
#
#   cp .env.example .env.local
#   NEXT_PUBLIC_LAUNCHLIST_KEY=your-form-key
#
NEXT_PUBLIC_LAUNCHLIST_KEY=
